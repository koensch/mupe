{
  "serial": {
    "comment": "protocol for B&G NETWORK series",
    "port": "/dev/ttyUSB0",
    "baudrate": 11008,
    "databits": 8,
    "stopbits": 2,
    "parity": "odd",
    "mode": "passive"
  },
  "ethernet": {
    "comment": "network interface for SignalK protocol",
    "device": "eth0",
    "protocol": "tcp",
    "remote_ip": "192.168.0.10",
    "remote_port": 12345,
    "local_port": 1957
  },
  "nmea2000": {
    "comment": "CAN bus interface for NMEA 2000 protocol",
    "can_interface": "can0"
  },
  "timer": {
    "comment": "serial counter interval",
    "interval_ms": 10
  },
  "webserver": {
    "comment": "webserver for status page",
    "port": 8080
  },
  "logging": {
    "file": "marine_gateway.log",
    "level": "debug"
  }
}
